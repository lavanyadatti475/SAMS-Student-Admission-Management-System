generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                   Int                  @id @default(autoincrement())
  fullName             String
  email                String               @unique
  mobile               String
  passwordHash         String
  role                 String               @default("student")
  emailVerified        Boolean              @default(false)
  verificationToken    String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  profileCompleted     Boolean              @default(false)
  profilePhoto         String?
  dob                  String?
  gender               String?
  bloodGroup           String?
  nationality          String?
  religion             String?
  category             String?
  address              String?
  guardianName         String?
  guardianOccupation   String?
  guardianIncome       String?
  emergencyContact     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  rollNumber           String?              @unique
  academicDetails      AcademicDetail?
  achievements         Achievement[]
  admissionForm        AdmissionForm?
  admissionStatus      AdmissionStatus?
  notifications        Notification[]
  participations       Participation[]
  scholarships         StudentScholarship[]
  uploadedDocuments    UploadedDocument[]
}

model AcademicDetail {
  id                     Int      @id @default(autoincrement())
  studentId              Int      @unique
  secondarySchool        String?
  secondaryBoard         String?
  secondaryPercentage    Float?
  secondaryYear          Int?
  intermediateCollege    String?
  intermediateBoard      String?
  intermediatePercentage Float?
  intermediateYear       Int?
  examName               String?
  examRank               String?
  examScore              String?
  examYear               Int?
  updatedAt              DateTime @updatedAt
  student                Student  @relation(fields: [studentId], references: [id])
}

model AdmissionForm {
  id                  Int       @id @default(autoincrement())
  studentId           Int       @unique
  course              String
  branch              String
  admissionCategory   String
  hostelRequired      Boolean   @default(false)
  scholarshipRequired Boolean   @default(false)
  previousInstitution String?
  declarationAccepted Boolean
  draft               Boolean   @default(true)
  submittedAt         DateTime?
  status              String    @default("draft")
  updatedAt           DateTime  @updatedAt
  student             Student   @relation(fields: [studentId], references: [id])
}

model UploadedDocument {
  id                  Int      @id @default(autoincrement())
  studentId           Int
  category            String
  subCategory         String
  documentName        String
  fileName            String
  originalFileName    String
  filePath            String
  publicUrl           String?
  mimeType            String
  fileSize            Int
  verificationStatus  String   @default("Pending")
  verificationRemarks String?
  uploadedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
  student             Student  @relation(fields: [studentId], references: [id])
}

model AdmissionStatus {
  id                Int      @id @default(autoincrement())
  studentId         Int      @unique
  applicationStatus String   @default("draft")
  documentStatus    String   @default("pending")
  auditNotes        String?
  updatedAt         DateTime @updatedAt
  student           Student  @relation(fields: [studentId], references: [id])
}

model Admin {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id          Int       @id @default(autoincrement())
  studentId   Int
  title       String
  message     String
  category    String    @default("General Announcement")
  targetBatch String    @default("All")
  eventDate   DateTime?
  venue       String?
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model EventBroadcast {
  id             Int       @id @default(autoincrement())
  title          String
  message        String
  category       String    @default("General Announcement")
  targetBatch    String    @default("All")
  eventDate      DateTime?
  venue          String?
  recipientCount Int       @default(0)
  createdBy      String?
  createdAt      DateTime  @default(now())
}

model Scholarship {
  id          Int                  @id @default(autoincrement())
  name        String
  description String
  amount      Float
  eligibility String
  deadline    DateTime
  createdAt   DateTime             @default(now())
  students    StudentScholarship[]
}

model StudentScholarship {
  id            Int         @id @default(autoincrement())
  studentId     Int
  scholarshipId Int
  status        String      @default("pending")
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])

  @@unique([studentId, scholarshipId])
}

model AdmissionLetter {
  id          Int      @id @default(autoincrement())
  studentId   Int
  filePath    String
  generatedAt DateTime @default(now())
}

model StudentQR {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  qrCode    String
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  action      String
  performedBy Int?
  studentId   Int?
  details     String?
  createdAt   DateTime @default(now())
}

model Achievement {
  id          Int       @id @default(autoincrement())
  studentId   Int
  category    String
  title       String
  description String?
  level       String?
  position    String?
  organizer   String?
  eventDate   DateTime?
  createdAt   DateTime  @default(now())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Participation {
  id        Int       @id @default(autoincrement())
  studentId Int
  category  String
  title     String
  organizer String?
  location  String?
  eventDate DateTime?
  createdAt DateTime  @default(now())
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
